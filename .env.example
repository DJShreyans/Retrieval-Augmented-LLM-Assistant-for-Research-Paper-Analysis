# ==========================================
# ResearchMate Environment Configuration
# ==========================================

# --- LLM Provider Settings (Section 2b) ---
# Options: none | openai | anthropic | gemini | openai_compatible
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
# LLM_BASE_URL is used when LLM_PROVIDER=openai_compatible (e.g., Groq, Together, Ollama)
LLM_BASE_URL=

# --- PDF Storage Source (Section 2e) ---
# Options: local | r2
PDF_SOURCE=local
# Local folder containing PDF research papers (recursive scan)
PDF_DIR=d:/R2
# Cloudflare R2 / S3 settings (required only when PDF_SOURCE=r2)
R2_ENDPOINT=
R2_BUCKET=
R2_PREFIX=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Databases & Persistent Stores (Section 2c) ---
# App store (SQLAlchemy): SQLite in dev, PostgreSQL in production
DATABASE_URL=sqlite:///./data/app.db
# Corpus store: SQLite FTS5 index & FAISS vector storage
CORPUS_DB_PATH=./data/corpus.db
FAISS_INDEX_PATH=./data/faiss/index.faiss
THUMBNAILS_DIR=./data/thumbnails
CACHE_DIR=./data/cache

# --- Authentication & Security (Section 2d) ---
GOOGLE_CLIENT_ID=
JWT_SECRET=change-this-to-a-secure-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ADMIN_EMAILS=admin@example.com
PUBLIC_BASE_URL=http://localhost:8000

# --- Search & Model Acceleration ---
USE_RERANKER=false
DEVICE=cpu
